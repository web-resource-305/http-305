<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload — HTTP 305</title>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#153a59">
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        .allowed-types {
            font-size: 12px;
            color: var(--text-muted);
            margin: -12px 0 20px;
            line-height: 1.5;
        }

        .allowed-types code {
            background: var(--bg);
            padding: 1px 5px;
            border-radius: 4px;
            font-size: 11px;
        }

        .input-group input[type="file"] {
            padding: 10px 16px;
            cursor: pointer;
        }

        .input-group input[type="file"]::file-selector-button {
            padding: 6px 14px;
            margin-right: 12px;
            font-size: 13px;
            font-weight: 600;
            color: #fff;
            background: var(--accent);
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: background 0.2s;
        }

        .input-group input[type="file"]::file-selector-button:hover {
            background: var(--accent-hover);
        }

        .size-limit {
            font-size: 12px;
            color: var(--text-muted);
            margin: -12px 0 20px;
        }
    </style>
</head>

<body>
    <div class="card">
        <div class="logo">
            <h1>HTTP <span>305</span></h1>
            <p>Upload to cache</p>
        </div>

        <form action="/upload" method="POST" enctype="multipart/form-data">
            <div class="input-group">
                <label for="file">File</label>
                <input type="file" name="file" id="file" accept="{{acceptTypes}}" required>
            </div>
            <p class="allowed-types">
                Allowed: {{#each extensions}}<code>{{this}}</code>{{#unless @last}} {{/unless}}{{/each}}
            </p>
            <p class="size-limit">Max file size: {{maxSizeMB}} MB</p>

            <div class="input-group">
                <label for="url">Original URL <span style="font-weight: 400; color: var(--text-muted)">(optional)</span></label>
                <input type="url" name="url" id="url" placeholder="https://example.com/report.pdf">
            </div>

            <button type="submit" class="btn btn-block">Upload</button>
        </form>

        <div class="footer">
            <p>File will be cached and available via permalink</p>
        </div>
    </div>
</body>

</html>
